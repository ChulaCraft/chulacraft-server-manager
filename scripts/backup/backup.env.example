# /etc/chulacraft/backup/backup.env (root:root 0600). Copy, then edit.
# Placeholders only: never commit real values.

# Required. Posted to on every failed run (JSON {"content": "..."}).
ALERT_WEBHOOK_URL=
# Space separated minecraft@<id> instances the `world` target archives.
WORLD_INSTANCES="survival"
WORLD_BASE=/srv/minecraft/instances
BOT_DB_PATH=/srv/chulacraft/discord/data/db.json

# Disk guard (D4): refuse unless available - estimate >= max(MIN_FREE_GIB, MIN_FREE_PCT of the filesystem).
MIN_FREE_GIB=20
MIN_FREE_PCT=15

# supabase target (D5): digest-pinned image, and /etc/chulacraft/backup/{pgpass,pg_service.conf}
# (0600, service "chulacraft", host = Supabase session pooler, port 5432). pg_service.conf must verify
# the server, not just encrypt:
#   [chulacraft]
#   host=...
#   port=5432
#   dbname=postgres
#   user=...
#   sslmode=verify-full
#   sslrootcert=/pg/supabase-ca.crt
# /pg is the config directory as the container sees it, so the CA certificate (downloaded from the
# Supabase dashboard: Database settings, SSL configuration) goes at /etc/chulacraft/backup/supabase-ca.crt
# (0644 is fine, it is public; the directory stays root-only).
PG_IMAGE=postgres:17-alpine@sha256:REPLACE_WITH_PINNED_DIGEST
# Used only for the first supabase run, before there is a previous size.
SUPABASE_FIRST_ESTIMATE_MIB=512

# Defaults, shown for reference.
# BACKUP_ROOT=/var/backups/chulacraft
# MANIFEST_DIR=/var/lib/chulacraft-backup/manifest
# KEEP_DAILY=7
# KEEP_WEEKLY=4
# KEEP_MANUAL=3
# SAVE_TIMEOUT=120
