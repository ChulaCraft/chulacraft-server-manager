[Unit]
Description=Minecraft Server %i
After=network.target
Wants=network.target
BindsTo=minecraft@%i.socket
After=minecraft@%i.socket

[Service]
Type=simple
User=mcsv
Group=mcsv-mgr
UMask=0002

WorkingDirectory=/srv/minecraft/instances/%i

ExecStart=/lib/jvm/java-21-openjdk-amd64/bin/java \
  -Xms2G -Xmx6G \
  -Djava.library.path=libraries \
  -Dsun.java.command="minecraft@%i" \
  -jar server.jar \
  nogui

# stdin control
StandardInput=socket

# logging
StandardOutput=journal
StandardError=journal

Restart=on-failure
RestartSec=5s

StartLimitIntervalSec=300s
StartLimitBurst=2

# CLEAN SHUTDOWN
ExecStop=/bin/sh -c 'printf "stop\n" > /run/minecraft/%i.stdin'
TimeoutStopSec=90
KillSignal=SIGCONT
KillMode=mixed
SuccessExitStatus=0

# safety
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

ReadWritePaths=/srv/minecraft/instances/%i

[Install]
WantedBy=multi-user.target
