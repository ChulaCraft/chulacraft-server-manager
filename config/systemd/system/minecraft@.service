[Unit]
Description=Minecraft Server %i
After=network.target
Wants=network.target
Requires=minecraft@%i.socket

[Service]
Type=simple
User=mcsv
Group=mcsv-mgr
UMask=0002

WorkingDirectory=/srv/minecraft/instances/%i

# Heap: override in /etc/mcsv_manager/minecraft.env (all instances) or
# /etc/mcsv_manager/minecraft-<id>.env (one instance), e.g. MC_XMX=8G.
# Java: systemd cannot take the executable from a variable, so to use another JVM
# run `systemctl edit minecraft@.service` and set `ExecStart=` then a full new line.
Environment=MC_XMS=2G MC_XMX=6G
EnvironmentFile=-/etc/mcsv_manager/minecraft.env
EnvironmentFile=-/etc/mcsv_manager/minecraft-%i.env

ExecStart=/usr/bin/java \
  -Xms${MC_XMS} -Xmx${MC_XMX} \
  -Djava.library.path=libraries \
  -Dsun.java.command="minecraft@%i" \
  -jar server.jar \
  nogui

# stdin control
StandardInput=socket

# logging
StandardOutput=journal
StandardError=journal

Restart=no

# CLEAN SHUTDOWN
ExecStop=/bin/sh -c 'printf "stop\n" > /run/minecraft/%i.stdin'
TimeoutStopSec=90
KillSignal=SIGCONT
KillMode=mixed
SuccessExitStatus=0

# safety
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

ReadWritePaths=/srv/minecraft/instances/%i

[Install]
WantedBy=multi-user.target
