# Build and test image. No Rust toolchain is needed on the host: scripts/dev-cargo.sh runs cargo in here.
# ubuntu:22.04 keeps the release binary's glibc requirement low (2.35).
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config libsystemd-dev ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain stable -c clippy -c rustfmt \
    && chmod -R a+rwX /usr/local/rustup /usr/local/cargo
RUN cargo install cargo-audit --locked && chmod -R a+rwX /usr/local/cargo
WORKDIR /work
